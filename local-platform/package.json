{
  "name": "drawhime-local-platform",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "build:packages": "pnpm --filter @drawhime/contracts --filter @drawhime/database --filter @drawhime/service-runtime --filter @drawhime/inference-runtime --filter @drawhime/main-platform-client run build",
    "build:services": "pnpm --filter @drawhime/api --filter @drawhime/scheduler --filter @drawhime/inference-worker --filter @drawhime/training-worker --filter @drawhime/artifact-service --filter @drawhime/gpu-agent run build",
    "build:frontends": "pnpm --filter @drawhime/web --filter @drawhime/admin run build",
    "build:desktop": "pnpm --filter @drawhime/desktop run build:web",
    "build": "pnpm run build:packages && pnpm run build:services && pnpm run build:frontends",
    "type-check": "pnpm run build:packages && pnpm -r run type-check",
    "test": "pnpm run build:packages && pnpm --filter @drawhime/api --filter @drawhime/inference-worker run build && pnpm --filter @drawhime/service-runtime --filter @drawhime/inference-runtime --filter @drawhime/api --filter @drawhime/inference-worker run test",
    "dev": "node scripts/dev.mjs",
    "deploy:production": "node scripts/deploy-production.mjs",
    "deploy:quick": "node scripts/deploy-production.mjs",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:diff": "prisma migrate diff --from-empty --to-schema-datamodel prisma/schema.prisma --script",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:validate": "prisma validate",
    "bootstrap:anima": "node scripts/bootstrap-anima-catalog.mjs",
    "bootstrap:tag-translations": "node apps/api/dist/bootstrap-tag-translations.js",
    "sync:anima-models": "node scripts/sync-anima-base-models.mjs",
    "desktop:resource-manifest": "node scripts/manage-desktop-resource-manifest.mjs",
    "desktop:deploy-manifest": "node scripts/deploy-desktop-resource-manifest.mjs",
    "desktop:publish-application": "node scripts/publish-desktop-application-update.mjs",
    "desktop:validate-windows-host": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/validate-desktop-windows-host.ps1",
    "desktop:validate-update-e2e": "node scripts/validate-desktop-update-e2e.mjs",
    "desktop:set-version": "node scripts/set-desktop-version.mjs",
    "desktop:build-runtime": "node scripts/build-desktop-runtime.mjs",
    "desktop:build-captioner": "node scripts/build-desktop-captioner.mjs",
    "desktop:build-trainer": "node scripts/build-desktop-trainer.mjs",
    "migrate:main-loras": "node scripts/migrate-main-loras.mjs",
    "requeue:training-fast": "node scripts/requeue-active-training-fast-profile.mjs",
    "deploy:training-runtime": "node scripts/deploy-training-runtime.mjs",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "prettier": "^3.6.2",
    "prisma": "^5.22.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "zod": "^3.25.76"
  }
}
