# 本文件只提供本地模型独立平台示例配置，不填写生产凭证。
NODE_ENV=development
# 仅部署机直连生产 SSH 不稳定时设置，不写入生产应用私有环境。
LOCAL_PLATFORM_DEPLOY_PROXY_JUMP=<ssh-host-alias>
DATABASE_URL=mysql://local_platform:local_platform@127.0.0.1:3317/drawhime_local
REDIS_URL=redis://127.0.0.1:6390
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=drawhime-local
S3_ACCESS_KEY=local_access
S3_SECRET_KEY=local_secret_dev_only
DESKTOP_GALLERY_UPLOAD_TEMP_DIR=./local/desktop-gallery-uploads
MAIN_PLATFORM_BASE_URL=https://www.xanime.ink
MAIN_PLATFORM_INTERNAL_URL=http://127.0.0.1:6369
MAIN_PLATFORM_AUDIENCE=drawhime-local-platform
MAIN_PLATFORM_CLIENT_ID=<oauth-client-id>
MAIN_PLATFORM_CLIENT_SECRET=<oauth-client-secret>
LOCAL_SESSION_TTL_HOURS=12
LOCAL_API_PORT=7102
LOCAL_SCHEDULER_PORT=7103
LOCAL_GPU_AGENT_PORT=7110
LOCAL_INFERENCE_WORKER_PORT=7111
LOCAL_TRAINING_WORKER_PORT=7112
LOCAL_ARTIFACT_SERVICE_PORT=7113
LOCAL_API_BASE_URL=http://127.0.0.1:7102
VITE_LOCAL_API_BASE=/local-model-api
LOCAL_SCHEDULER_BASE_URL=http://127.0.0.1:7103
LOCAL_GPU_AGENT_BASE_URL=http://127.0.0.1:7110
LOCAL_INFERENCE_WORKER_BASE_URL=http://127.0.0.1:7111
LOCAL_TRAINING_WORKER_BASE_URL=http://127.0.0.1:7112
LOCAL_ARTIFACT_SERVICE_BASE_URL=http://127.0.0.1:7113
LOCAL_PUBLIC_API_BASE_URL=https://www.xanime.ink/local-model-api
TRAINING_RUNTIME_BASE_URL=http://<private-gpu-host>:7120
TRAINING_RUNTIME_TOKEN=<random-training-service-token>
# 训练产物按小分片断点续传，弱网只重传失败分片。
TRAINING_OUTPUT_CHUNK_BYTES=1048576
# 弱网分片并发数；过高会增加超时率，生产实测 8 路更稳定。
TRAINING_OUTPUT_CONCURRENCY=8
COMFYUI_BASE_URL=http://<private-gpu-host>:8189
COMFYUI_SERVICE_TOKEN=<comfyui-protected-endpoint-token>
GPU_AGENT_TOKEN=<random-service-token>
# 推理与训练使用同一物理 GPU 时必须设为 true，调度器会在租约层保持互斥，避免训练长期饥饿。
GPU_WORKLOADS_SHARE_DEVICE=true
PROMPT_ASSIST_BASE_URL=<openai-compatible-base-url>
PROMPT_ASSIST_API_KEY=<private-api-key>
PROMPT_ASSIST_MODEL=gpt-5.6-sol
PROMPT_ASSIST_REASONING_EFFORT=high
PROMPT_ASSIST_TIMEOUT_SEC=90
PROMPT_ASSIST_MAX_OUTPUT_CHARS=5000
# 由离线发布工具生成的 Ed25519 签名资源清单信封；未配置时公开端点返回明确未发布状态。
DESKTOP_RESOURCE_MANIFEST_ENVELOPE_FILE=<absolute-signed-manifest-envelope-file>
DESKTOP_RESOURCE_STORAGE_ROOT=<absolute-desktop-resource-storage-directory>
# 可选；只供 API 代理签名清单中的 Civitai 官方模型来源，桌面端不会获得该令牌。
DESKTOP_RESOURCE_CIVITAI_TOKEN=<private-civitai-download-token>
# 桌面设备授权确认页与会话有效天数；原始设备密钥只保存在 Windows Credential Manager。
DESKTOP_AUTH_VERIFICATION_URL=https://www.xanime.ink/local-model/
DESKTOP_SESSION_TTL_DAYS=30
