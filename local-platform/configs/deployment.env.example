# 本文件只列出部署机配置键；复制到 .private/production.env 后填写真实地址，禁止提交该私有文件。
LOCAL_PLATFORM_DEPLOY_HOST=root@<platform-host>
LOCAL_PLATFORM_DEPLOY_PORT=22
LOCAL_PLATFORM_DEPLOY_KEY=<absolute-private-key-path>
LOCAL_PLATFORM_DEPLOY_PROXY_JUMP=
TRAINING_GPU_DEPLOY_HOST=root@<gpu-host>
TRAINING_GPU_DEPLOY_PORT=22
TRAINING_GPU_DEPLOY_KEY=<absolute-private-key-path>
TRAINING_PLATFORM_SOURCE_IP=<platform-private-or-public-ip>
TRAINING_RUNTIME_BASE_URL=http://<gpu-private-host>:7120
COMFYUI_BASE_URL=http://<gpu-private-host>:8189
CIVITAI_API_TOKEN_FILE=<absolute-private-token-file>
