# 本文件定义独立桌面模型下载 Runtime，不重启或占用训练与推理进程。
[Unit]
Description=DrawHime Desktop Model Runtime
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/data/drawhime-desktop-model-runtime
EnvironmentFile=/data/drawhime-desktop-model-runtime/runtime.env
ExecStart=/usr/bin/python3 /data/drawhime-desktop-model-runtime/server.py
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
