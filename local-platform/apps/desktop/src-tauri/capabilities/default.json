{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "桌面主窗口仅使用核心 IPC 和本地业务命令。",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:webview:allow-set-webview-zoom",
    "core:window:allow-set-theme",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "dialog:allow-open",
    { "identifier": "opener:allow-open-url", "allow": [{ "url": "https://www.xanime.ink/local-model/*" }] }
  ]
}
