{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DrawHime Desktop",
  "version": "0.1.10",
  "identifier": "ink.xanime.drawhime.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:7200",
    "beforeBuildCommand": "pnpm build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "create": false,
        "title": "DrawHime Desktop",
        "width": 1380,
        "height": 860,
        "minWidth": 720,
        "minHeight": 560,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$PICTURE/**",
          "$APPDATA/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.ico"
    ],
    "targets": [
      "nsis"
    ],
    "shortDescription": "使用本机 GPU 进行生成、打标和 LoRA 训练",
    "longDescription": "DrawHime Desktop 本地模型客户端，不在安装包中分发生成模型或 LoRA。",
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "customLanguageFiles": {
          "SimpChinese": "nsis/languages/SimpChinese.nsh",
          "English": "nsis/languages/English.nsh"
        },
        "installerHooks": "nsis/installer-hooks.nsh"
      }
    }
  }
}
