LangString installingWebview2 ${LANG_ENGLISH} "Installing WebView2..."
LangString newerVersionInstalled ${LANG_ENGLISH} "A newer ${PRODUCTNAME} version is installed. Uninstall it before installing this older version; the uninstaller lets you choose whether to keep models and local data."
