# ===== 绘图姬 DrawHime 环境配置 =====
# 本文件仅包含启动级配置。功能设置（限流/价格/超时/冷却等）通过管理后台操作 system_configs 表持久化。
# 本地开发可复制到 local/private/.env 覆盖私有值；生产配置由服务器私有 ecosystem.config.js 管理。

# === 运行模式 ===
APP_ENV=development
APP_BASE_URL=http://localhost:5173
# Grok 参考图视频要求上游可访问 HTTPS URL；生产设置为主站媒体公网基址。
PUBLIC_MEDIA_BASE_URL=https://www.xanime.ink
# 视频下载与本地写入上限保持一致，默认 100MB。
MEDIA_VIDEO_MAX_FILE_SIZE_BYTES=104857600

# === 服务端口 ===
BACKEND_PORT=6369
DRAWING_PORT=3005
DRAWING_WORKER_PORT=3012
MEDIA_PORT=3013
BOT_PORT=3004
BOT_RENDERER_PORT=3014
WSPROXY_PORT=3011
NOTIFICATION_WORKER_PORT=3015
OPS_WORKER_PORT=3016
WEB_PORT=5173
ADMIN_PORT=5174

# === 服务间调用地址 ===
BACKEND_INTERNAL_URL=http://localhost:6369
DRAWING_SERVICE_URL=http://localhost:3005
DRAWING_WORKER_URL=http://localhost:3012
MEDIA_SERVICE_URL=http://localhost:3013
WSPROXY_SERVICE_URL=http://localhost:3011
WSPROXY_PUBLIC_WS_URL=wss://wsbot.xanime.ink
BOT_SERVICE_URL=http://localhost:3004
BOT_RENDERER_URL=http://localhost:3014
NOTIFICATION_WORKER_URL=http://localhost:3015
OPS_WORKER_URL=http://localhost:3016

# === 数据库（启动必需） ===
# 生产 PM2/宿主机进程使用 127.0.0.1:3306；容器内应用使用 1Panel-mariadb-4zb0:3306，真实密码只写入私有环境文件。
DATABASE_URL=mysql://<user>:<password>@127.0.0.1:3306/aiimagev3?connection_limit=20&pool_timeout=10&connect_timeout=10
# 开发脚本默认拒绝对非本地 DATABASE_URL 执行自动 db push；确认是开发库时才改为 true。
AIIMAGE_ALLOW_REMOTE_DB_PUSH=false
# 生产 PM2/宿主机进程使用 127.0.0.1:6379；容器内应用使用 1Panel-redis-m7uL:6379，真实密码只写入私有环境文件。
REDIS_URL=redis://:<password>@127.0.0.1:6379
REDIS_KEY_PREFIX=aiimage:v3
REDIS_COMMAND_TIMEOUT_MS=300
REDIS_CONNECT_TIMEOUT_MS=1000
REDIS_MAX_RETRIES=3
RATE_LIMIT_MODE=redis

# === 安全密钥（启动必需） ===
# 生产环境必须设置强随机密钥，长度 >= 32
JWT_SECRET=<random-32-bytes>
# 服务间通信 token，本地开发可留空（跳过校验），生产必须设置
WS_PROXY_TOKEN=<random-32-bytes>
LOCAL_PLATFORM_INTEGRATION_TOKEN=<random-32-bytes>
MAIN_PLATFORM_ISSUER=https://www.xanime.ink

# === wsproxy 心跳 ===
WSPROXY_HEARTBEAT_INTERVAL_MS=30000
WSPROXY_HEARTBEAT_MAX_MISSES=2

# === CORS（允许的前端源，逗号分隔） ===
# 生产环境设置为实际域名
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# === 媒体本地存储 ===
# 当前生产只使用本地文件模式；生成原图不压缩，参考图任务输入版压缩到 3MB。
STORAGE_DRIVER=local
MEDIA_STORAGE_PATH=local/media-storage
MEDIA_LOCAL_CACHE_MINUTES=30
MEDIA_CACHE_CLEANUP_INTERVAL_MS=300000
MEDIA_COMPLETED_LOCAL_PROTECT_MINUTES=30
MEDIA_CLEANUP_EXPIRED_BATCH_SIZE=200
MEDIA_PROTECTED_TASK_LIMIT=3000
REFERENCE_SINGLE_IMAGE_MAX_BYTES=3145728
REFERENCE_TASK_INPUT_MAX_BYTES=3145728
# backend 等待参考图转码的上限，以及 media-service 两类压缩等待队列的保护容量。
REFERENCE_MEDIA_UPLOAD_TIMEOUT_MS=60000
MEDIA_REFERENCE_INTERACTIVE_QUEUE_LIMIT=16
MEDIA_REFERENCE_BACKGROUND_QUEUE_LIMIT=64

# === Bot 参考图和卡片渲染本地资源 ===
# Bot 命令中的 QQ/头像/外链参考图会先转存 media-service 本地暂存，再创建绘图任务。
BOT_REFERENCE_IMAGE_LIMIT=8
BOT_REFERENCE_MAX_BYTES=20971520
BOT_REFERENCE_DOWNLOAD_TIMEOUT_MS=12000
BOT_REFERENCE_UPLOAD_TIMEOUT_MS=60000
BOT_REFERENCE_PREVIEW_WIDTH=320
BOT_REFERENCE_PREVIEW_QUALITY=65
BOT_RENDER_TIMEOUT_MS=25000
# bot-renderer 只从本地白名单目录读取字体和任务图片，不在截图阶段请求公网图片。
BOT_RENDERER_ASSET_DIR=local/bot-renderer-assets
BOT_RENDERER_FONT_FILE=NotoSansSC-Regular.otf
BOT_RENDERER_LOCAL_IMAGE_DIRS=local/media-storage
BOT_RENDERER_QQ_AVATAR_TIMEOUT_MS=3000
BOT_RENDERER_BROWSER_LAUNCH_TIMEOUT_MS=45000
CARD_SCREENSHOT_TIMEOUT_MS=20000

# === 以下是可选的环境变量覆盖 ===
# 功能设置默认值由 config-service.ts 中 CONFIG_KEYS 定义。
# 数据库 system_configs 表优先于环境变量，环境变量优先于代码默认值。
# 如需临时覆盖，设置对应大写环境变量即可，例如：
# DRAWING_PRICE_PER_GEN=0.10
# QUOTA_FREE_DAILY_LIMIT=20
# DRAWING_COOLDOWN_SECONDS=60
