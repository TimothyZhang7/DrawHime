{
  "name": "@aiimage/backend",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch --import tsx src/main.ts",
    "build": "tsc -p tsconfig.json",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "type-check": "tsc -p tsconfig.json --noEmit"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aiimage/core-utils": "workspace:*",
    "@aiimage/shared-contracts": "workspace:*",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.19.20",
    "prisma": "^5.22.0",
    "tsx": "^4.22.4",
    "typescript": "~5.9.3"
  }
}
